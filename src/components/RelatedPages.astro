---
import { getUi } from '../data/i18n';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { getProductRelatedLinks, type InternalLink } from '../lib/internal-links';

interface Props {
	locale?: LocaleCode;
	links?: InternalLink[];
	title?: string;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);
const title = Astro.props.title ?? ui.common.relatedPages;
const links =
	Astro.props.links ??
	getProductRelatedLinks(locale, {
		esp: ui.nav.esp,
		aimbot: ui.nav.aimbot,
		features: ui.nav.features,
		setup: ui.nav.setup,
		pricing: ui.nav.pricing,
		updates: ui.nav.updates,
		faq: ui.nav.faq,
	});
---

{
	links.length > 0 && (
		<nav class="related-pages" aria-label={title}>
			<p class="related-pages__label">{title}</p>
			<div class="related-pages__row">
				{links.map((link) => (
					<a href={link.href} class="related-pages__link">
						{link.label}
					</a>
				))}
			</div>
		</nav>
	)
}

<style>
	.related-pages {
		margin-top: 1.75rem;
		padding: clamp(1.1rem, 2.5vw, 1.35rem);
		border-radius: 1rem;
		border: 1px solid rgba(104, 112, 82, 0.14);
		background: linear-gradient(145deg, rgba(23, 27, 26, 0.88) 0%, rgba(17, 21, 20, 0.85) 100%);
	}

	.related-pages__label {
		margin: 0 0 0.85rem;
		font-size: 0.78rem;
		font-weight: 800;
		color: var(--color-orchid);
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.related-pages__row {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
		gap: 0.55rem;
	}

	.related-pages__link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		padding: 0.7rem 0.85rem;
		border-radius: 0.75rem;
		border: 1px solid rgba(104, 112, 82, 0.18);
		background: rgba(9, 11, 11, 0.45);
		color: rgba(255, 255, 255, 0.82);
		font-size: 0.84rem;
		font-weight: 600;
		text-align: center;
		transition:
			color 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease,
			transform 0.2s ease;
	}

	.related-pages__link::after {
		content: '→';
		color: var(--color-orchid);
		font-size: 0.9em;
	}

	.related-pages__link:hover {
		color: var(--color-ink);
		border-color: rgba(210, 174, 118, 0.4);
		background: rgba(17, 21, 20, 0.75);
		transform: translateY(-1px);
	}
</style>
