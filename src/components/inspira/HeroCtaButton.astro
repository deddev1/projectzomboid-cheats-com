---
/** Hero-only CTA — Inspira-style glowing border + shimmer (distinct from navbar Get Access). */
interface Props {
	href: string;
	label: string;
	hint?: string;
	rel?: string;
	ariaLabel?: string;
}

const { href, label, hint, rel = 'noopener noreferrer', ariaLabel } = Astro.props;
---

<a
	class="hero-cta inspira-hero-cta"
	href={href}
	rel={rel}
	data-inspira-ripple-button
	data-ripple-color="rgba(210, 174, 118, 0.45)"
	data-ripple-duration="700"
	aria-label={ariaLabel ?? label}
>
	<span class="hero-cta__glow" aria-hidden="true"></span>
	<span class="hero-cta__border" aria-hidden="true"></span>
	<span class="hero-cta__inner">
		<span class="hero-cta__text">
			<span class="hero-cta__label">{label}</span>
			{hint && <span class="hero-cta__hint">{hint}</span>}
		</span>
		<span class="hero-cta__icon" aria-hidden="true">
			<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path
					d="M4 10h10M11 6l4 4-4 4"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</span>
	</span>
</a>
