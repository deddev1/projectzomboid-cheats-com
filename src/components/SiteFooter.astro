---
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { siteConfig } from '../data/site';
import RippleButton from './inspira/RippleButton.astro';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);

const exploreLinks = [
	{ label: ui.nav.features, href: getLocalizedPath('features', locale) },
	{ label: ui.nav.pricing, href: getLocalizedPath('pricing', locale) },
	{ label: ui.nav.esp, href: getLocalizedPath('project-zomboid-esp', locale) },
	{ label: ui.nav.aimbot, href: getLocalizedPath('project-zomboid-aimbot', locale) },
	{ label: 'Wallhack', href: getLocalizedPath('wallhack', locale) },
	{ label: 'Radar', href: getLocalizedPath('radar', locale) },
	{ label: ui.nav.cheats, href: getLocalizedPath('hacks', locale) },
];

const resourceLinks = [
	{ label: ui.nav.setup, href: getLocalizedPath('setup', locale) },
	{ label: ui.nav.updates, href: getLocalizedPath('updates', locale) },
	{ label: ui.nav.faq, href: getLocalizedPath('faq', locale) },
	{ label: 'Guides', href: '/guides/' },
	{ label: 'Blog', href: '/blog/' },
	{ label: ui.nav.reviews, href: '/reviews/' },
];

const legalLinks = [
	{ label: 'Support', href: getLocalizedPath('support', locale) },
	{ label: 'Privacy', href: getLocalizedPath('privacy', locale) },
	{ label: 'Terms', href: getLocalizedPath('terms', locale) },
	{ label: 'Refund', href: getLocalizedPath('refund', locale) },
];

const year = new Date().getUTCFullYear();
---

<footer class="footer" id="support-footer">
	<div class="shell footer__inner">
		<div class="footer__brand">
			<p class="footer__name">{ui.product.title}</p>
			<p class="footer__tagline">{ui.footer.tagline}</p>
			<RippleButton
				href={siteConfig.checkoutUrl}
				variant="buy"
				class="footer__cta"
				rel="noopener noreferrer"
			>
				{ui.common.buyNow}
			</RippleButton>
		</div>

		<div class="footer__columns">
			<nav class="footer__col" aria-label={ui.footer.explore}>
				<p class="footer__col-title">{ui.footer.explore}</p>
				<ul class="footer__list">
					{
						exploreLinks.map((link) => (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav class="footer__col" aria-label="Resources">
				<p class="footer__col-title">Resources</p>
				<ul class="footer__list">
					{
						resourceLinks.map((link) => (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav class="footer__col" aria-label={ui.footer.help}>
				<p class="footer__col-title">{ui.footer.help}</p>
				<ul class="footer__list">
					{
						legalLinks.map((link) => (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>

		<div class="footer__bottom">
			<p class="footer__copy">© {year} {siteConfig.name}. All rights reserved.</p>
			<a class="footer__email" href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a>
		</div>
	</div>
</footer>

<style>
	.footer {
		margin-top: 1rem;
		border-top: 1px solid rgba(104, 112, 82, 0.16);
		background: linear-gradient(180deg, rgba(17, 21, 20, 0.55) 0%, rgba(9, 11, 11, 0.92) 100%);
		padding-block: 2rem;
		padding-bottom: calc(2rem + env(safe-area-inset-bottom, 0px));
	}

	.footer__inner {
		display: grid;
		gap: 1.75rem;
	}

	.footer__brand {
		display: grid;
		gap: 0.65rem;
		max-width: 22rem;
	}

	.footer__name {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--color-ink);
	}

	.footer__tagline {
		margin: 0;
		color: rgba(255, 255, 255, 0.72);
		font-size: 0.86rem;
		line-height: 1.55;
	}

	.footer__inner :global(.footer__cta) {
		justify-self: start;
		margin-top: 0.25rem;
		min-height: 2.35rem;
		padding: 0.5rem 1rem;
		font-size: 0.82rem;
	}

	.footer__columns {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem 1.5rem;
	}

	.footer__col-title {
		margin: 0 0 0.65rem;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-orchid);
	}

	.footer__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.45rem;
	}

	.footer__list a {
		color: rgba(255, 255, 255, 0.78);
		font-size: 0.84rem;
		font-weight: 600;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer__list a:hover {
		color: var(--color-ink);
	}

	.footer__bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.65rem 1rem;
		padding-top: 1.1rem;
		border-top: 1px solid rgba(104, 112, 82, 0.12);
	}

	.footer__copy {
		margin: 0;
		color: var(--color-faint);
		font-size: 0.78rem;
	}

	.footer__email {
		color: var(--color-muted);
		font-size: 0.78rem;
		font-weight: 600;
		transition: color 0.2s ease;
	}

	.footer__email:hover {
		color: var(--color-orchid);
	}

	@media (max-width: 760px) {
		.footer__columns {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.footer__col:last-child {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 480px) {
		.footer__columns {
			grid-template-columns: 1fr;
		}

		.footer__col:last-child {
			grid-column: auto;
		}

		.footer__bottom {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
