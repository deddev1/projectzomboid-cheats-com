---
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { siteConfig } from '../data/site';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);
const year = new Date().getUTCFullYear();

const exploreLinks = [
	{ label: ui.nav.home, href: getLocalizedPath('home', locale) },
	{ label: ui.nav.cheats, href: getLocalizedPath('hacks', locale) },
	{ label: ui.nav.esp, href: getLocalizedPath('project-zomboid-esp', locale) },
	{ label: ui.nav.aimbot, href: getLocalizedPath('project-zomboid-aimbot', locale) },
	{ label: 'Wallhack', href: getLocalizedPath('wallhack', locale) },
	{ label: 'Radar', href: getLocalizedPath('radar', locale) },
	{ label: ui.nav.features, href: getLocalizedPath('features', locale) },
];

const blogLinks = [
	{ label: ui.nav.blog, href: '/blog/' },
	{ label: ui.nav.reviews, href: '/reviews/' },
	{ label: 'Guides', href: '/guides/' },
	{ label: ui.nav.features, href: getLocalizedPath('features', locale) },
];

const supportLinks = [
	{ label: ui.nav.faq, href: getLocalizedPath('faq', locale) },
	{ label: ui.nav.setup, href: getLocalizedPath('setup', locale) },
	{ label: ui.nav.updates, href: getLocalizedPath('updates', locale) },
	{ label: 'Support', href: getLocalizedPath('support', locale) },
	{ label: 'Contact us', href: `mailto:${siteConfig.supportEmail}` },
];

const legalLinks = [
	{ label: 'Terms and Conditions', href: getLocalizedPath('terms', locale) },
	{ label: 'Privacy Policy', href: getLocalizedPath('privacy', locale) },
	{ label: 'Refund Policy', href: getLocalizedPath('refund', locale) },
	{ label: ui.nav.pricing, href: getLocalizedPath('pricing', locale) },
];
---

<footer class="footer" id="support-footer">
	<div class="footer__main">
		<div class="shell footer__main-inner">
			<div class="footer__nav">
				<nav class="footer__col" aria-label={ui.footer.explore}>
					<p class="footer__col-title">{ui.footer.explore}</p>
					<ul class="footer__list">
						{
							exploreLinks.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))
						}
					</ul>
				</nav>

				<nav class="footer__col" aria-label={ui.nav.blog}>
					<p class="footer__col-title">{ui.nav.blog}</p>
					<ul class="footer__list">
						{
							blogLinks.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))
						}
					</ul>
				</nav>

				<nav class="footer__col" aria-label="Support">
					<p class="footer__col-title">Support</p>
					<ul class="footer__list">
						{
							supportLinks.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))
						}
					</ul>
				</nav>

				<nav class="footer__col" aria-label={ui.footer.help}>
					<p class="footer__col-title">Legal</p>
					<ul class="footer__list">
						{
							legalLinks.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>

			<div class="footer__art" aria-hidden="true">
				<img
					src="/images/zomboid-wingman.webp"
					alt=""
					width="396"
					height="439"
					loading="lazy"
					decoding="async"
					class="footer__art-img"
				/>
			</div>
		</div>
	</div>

	<div class="footer__bar">
		<div class="shell footer__bar-inner">
			<p class="footer__copy">
				{siteConfig.name} | Copyright © {year}. All Rights Reserved.
			</p>
			<p class="footer__credit">
				Site by <a href={siteConfig.url}>projectzomboidcheats.com</a>
			</p>
		</div>
	</div>
</footer>

<style>
	.footer {
		margin-top: 0;
		overflow: hidden;
		background: linear-gradient(
			180deg,
			var(--color-surface-raised) 0%,
			var(--color-surface) 100%
		);
		border-top: 1px solid var(--color-border);
		color: var(--color-body);
	}

	.footer__main {
		padding-block: clamp(1.35rem, 2.5vw, 1.85rem);
	}

	.footer__main-inner {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: clamp(0.75rem, 2vw, 1.5rem);
	}

	.footer__nav {
		flex: 1 1 auto;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(0.75rem, 1.75vw, 1.35rem);
		min-width: 0;
		padding-bottom: 0.15rem;
	}

	.footer__col-title {
		margin: 0 0 0.65rem;
		font-family: var(--font-display);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-orchid);
		line-height: 1.2;
	}

	.footer__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.35rem;
	}

	.footer__list a {
		color: var(--color-muted);
		font-size: 0.875rem;
		font-weight: 400;
		line-height: 1.3;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer__list a:hover {
		color: var(--color-orchid);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.footer__art {
		position: relative;
		flex: 0 0 clamp(120px, 18vw, 220px);
		align-self: flex-end;
		height: clamp(150px, 18vw, 210px);
		margin-bottom: -0.15rem;
		pointer-events: none;
		-webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 24%, #000 100%);
		mask-image: linear-gradient(90deg, transparent 0%, #000 24%, #000 100%);
	}

	.footer__art-img {
		position: absolute;
		right: 0;
		bottom: 0;
		height: 100%;
		width: auto;
		max-width: none;
		object-fit: contain;
		object-position: right bottom;
	}

	.footer__bar {
		border-top: 1px solid var(--color-border);
		background: var(--color-midnight);
		padding-block: 0.65rem;
		padding-bottom: calc(0.65rem + env(safe-area-inset-bottom, 0px));
	}

	.footer__bar-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
	}

	.footer__copy {
		margin: 0;
		color: var(--color-faint);
		font-size: 0.8125rem;
		line-height: 1.4;
	}

	.footer__credit {
		margin: 0;
		color: var(--color-faint);
		font-size: 0.8125rem;
		line-height: 1.4;
	}

	.footer__credit a {
		color: var(--color-orchid);
		font-weight: 700;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer__credit a:hover {
		color: var(--color-warm);
	}

	@media (max-width: 980px) {
		.footer__main-inner {
			flex-direction: column;
			align-items: stretch;
		}

		.footer__nav {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			width: 100%;
			padding-bottom: 0;
		}

		.footer__art {
			flex: none;
			width: min(100%, 240px);
			height: clamp(140px, 38vw, 180px);
			margin-inline: auto;
			margin-bottom: 0;
			-webkit-mask-image: linear-gradient(
				180deg,
				transparent 0%,
				#000 18%,
				#000 82%,
				transparent 100%
			);
			mask-image: linear-gradient(180deg, transparent 0%, #000 18%, #000 82%, transparent 100%);
		}
	}

	@media (max-width: 520px) {
		.footer__nav {
			grid-template-columns: 1fr;
			gap: 1.1rem;
		}

		.footer__bar-inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
