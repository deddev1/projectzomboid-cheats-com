---
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';

interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	items?: Crumb[];
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);

const {
	items = [
		{ label: ui.nav.home, href: getLocalizedPath('home', locale) },
		{ label: ui.product.title },
	],
} = Astro.props;
---

<nav class="crumb-bar" aria-label="Breadcrumb">
	<div class="shell crumb-bar__inner">
		<ol class="crumb-bar__list">
			{
				items.map((item, index) => (
					<li class="crumb-bar__item">
						{index > 0 && (
							<span class="crumb-bar__sep" aria-hidden="true">
								/
							</span>
						)}
						{item.href ? (
							<a href={item.href} class="crumb-bar__link">
								{item.label}
							</a>
						) : (
							<span class="crumb-bar__current" aria-current="page">
								{item.label}
							</span>
						)}
					</li>
				))
			}
		</ol>
	</div>
</nav>

<style>
	.crumb-bar {
		border-block: 1px solid rgba(104, 112, 82, 0.12);
		background: transparent;
		content-visibility: auto;
		contain-intrinsic-size: 1px 64px;
	}

	@media (min-width: 761px) {
		.crumb-bar {
			background: transparent;
		}
	}

	.crumb-bar__inner {
		padding: 0.85rem 0;
	}

	.crumb-bar__list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.875rem;
		color: var(--color-faint);
	}

	.crumb-bar__item {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.crumb-bar__sep {
		opacity: 0.45;
	}

	.crumb-bar__link {
		color: var(--color-muted);
		transition: color 0.2s ease;
	}

	.crumb-bar__link:hover {
		color: var(--color-orchid);
	}

	.crumb-bar__current {
		color: var(--color-ink);
		font-weight: 500;
	}

	@media (max-width: 640px) {
		.crumb-bar__list {
			row-gap: 0.35rem;
			font-size: 0.82rem;
		}

		.crumb-bar__current {
			overflow-wrap: anywhere;
		}
	}
</style>
