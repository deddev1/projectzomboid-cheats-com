---
import { locales, type LocaleCode } from '../data/i18n/locales';
import { getLocalizedPath, type PageId } from '../data/i18n/routing';
import { getUi } from '../data/i18n';

interface Props {
	pageId: PageId;
	currentLocale: LocaleCode;
}

const { pageId, currentLocale } = Astro.props;
const currentMeta = locales.find((l) => l.code === currentLocale)!;
const ui = getUi(currentLocale);
---

<details class="lang-switcher">
	<summary class="lang-switcher__toggle" aria-label={ui.common.language}>
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
			<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"></circle>
			<path
				d="M3 12h18M12 3c2.5 2.8 3.8 6 3.8 9s-1.3 6.2-3.8 9M12 3c-2.5 2.8-3.8 6-3.8 9s1.3 6.2 3.8 9"
				stroke="currentColor"
				stroke-width="1.6"></path>
		</svg>
		<span>{currentMeta.nativeName}</span>
	</summary>
	<div class="lang-switcher__panel">
		<p class="lang-switcher__note">{ui.common.officialLanguageNote}</p>
		<ul class="lang-switcher__list">
			{
				locales.map((locale) => {
					const href = getLocalizedPath(pageId, locale.code);
					const isCurrent = locale.code === currentLocale;
					return (
						<li>
							<a
								href={href}
								hreflang={locale.hreflang}
								lang={locale.code}
								class:list={['lang-switcher__link', { 'is-current': isCurrent }]}
								aria-current={isCurrent ? 'page' : undefined}
								data-locale={locale.code}
							>
								<span class="lang-switcher__native">{locale.nativeName}</span>
								<span class="lang-switcher__region">{locale.region}</span>
							</a>
						</li>
					);
				})
			}
		</ul>
	</div>
</details>

<style>
	.lang-switcher {
		position: relative;
	}

	.lang-switcher__toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.32rem 0.58rem;
		border-radius: 999px;
		border: 1px solid rgba(104, 112, 82, 0.25);
		background: rgba(26, 22, 38, 0.85);
		color: var(--color-ink);
		font-size: 0.68rem;
		font-weight: 700;
		cursor: pointer;
		list-style: none;
		line-height: 1.2;
	}

	.lang-switcher__toggle span {
		max-width: 5.5rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.lang-switcher__toggle::-webkit-details-marker {
		display: none;
	}

	.lang-switcher__panel {
		position: absolute;
		right: 0;
		top: calc(100% + 0.35rem);
		z-index: 90;
		width: min(11.5rem, calc(100vw - 2rem));
		max-height: min(13.5rem, 52vh);
		overflow-y: auto;
		overflow-x: hidden;
		padding: 0.4rem;
		border-radius: 0.65rem;
		border: 1px solid rgba(104, 112, 82, 0.2);
		background: rgba(14, 10, 22, 0.98);
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.4);
		scrollbar-width: thin;
		scrollbar-color: rgba(104, 112, 82, 0.45) transparent;
	}

	.lang-switcher__panel::-webkit-scrollbar {
		width: 4px;
	}

	.lang-switcher__panel::-webkit-scrollbar-thumb {
		border-radius: 999px;
		background: rgba(104, 112, 82, 0.45);
	}

	.lang-switcher__note {
		margin: 0 0 0.35rem;
		padding: 0.32rem 0.42rem;
		border-radius: 0.45rem;
		background: rgba(104, 112, 82, 0.1);
		color: var(--color-muted);
		font-size: 0.62rem;
		line-height: 1.35;
	}

	.lang-switcher__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.12rem;
	}

	.lang-switcher__link {
		display: grid;
		gap: 0;
		padding: 0.34rem 0.45rem;
		border-radius: 0.42rem;
		color: var(--color-ink);
		transition: background 0.15s ease;
	}

	.lang-switcher__link:hover,
	.lang-switcher__link.is-current {
		background: rgba(104, 112, 82, 0.14);
	}

	.lang-switcher__native {
		font-size: 0.72rem;
		font-weight: 700;
		line-height: 1.25;
	}

	.lang-switcher__region {
		font-size: 0.58rem;
		color: var(--color-faint);
		line-height: 1.2;
	}

	@media (max-width: 960px) {
		.lang-switcher__panel {
			position: fixed;
			left: auto;
			right: var(--page-gutter);
			width: min(11.5rem, calc(100vw - 2rem));
			max-height: min(12rem, 46vh);
		}
	}
</style>

<script>
	document.querySelectorAll('.lang-switcher__link[data-locale]').forEach((link) => {
		link.addEventListener('click', () => {
			const code = link.getAttribute('data-locale');
			if (code) {
				document.cookie = `fc_locale=${code};path=/;max-age=31536000;SameSite=Lax`;
			}
		});
	});
</script>
