---
import { featureGallery, featureSectionImages } from '../data/zomboid';
import { getUi } from '../data/i18n';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { productFeatureDetails, productInfo, siteConfig } from '../data/site';
import {
	contentSrc,
	contentSrcSet,
	featureDetailSizes,
	featureGallerySizes,
} from '../lib/responsive-images';
import RippleButton from './inspira/RippleButton.astro';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);

const responsiveImage = (src: string) => ({
	src: contentSrc(src),
	srcset: contentSrcSet(src),
});
---

<div class="features-detail">
	{
		productFeatureDetails.map((section, index) => {
			const shot = featureSectionImages[section.id];
			const image = responsiveImage(shot.src);
			return (
				<article class="features-detail__section" id={`feature-${section.id}`}>
					<figure class="features-detail__figure media-frame">
						<img
							src={image.src}
							srcset={image.srcset}
							sizes={featureDetailSizes}
							alt={shot.alt}
							width="480"
							height="300"
							loading={index === 0 ? 'eager' : 'lazy'}
							decoding="async"
						/>
					</figure>

					<div class="features-detail__section-body">
						<header class="features-detail__section-head">
							<h2>{section.title}</h2>
							<p>{section.summary}</p>
						</header>

						<ul class="features-detail__list">
							{section.items.map((item) => (
								<li class="features-detail__item">
									<h3>{item.name}</h3>
									<p>{item.description}</p>
								</li>
							))}
						</ul>
					</div>
				</article>
			);
		})
	}

	<section class="features-detail__gallery" aria-label="Project Zomboid cheats screenshots">
		<header class="features-detail__gallery-head">
			<h2>In-game screenshots</h2>
			<p>Menu, ESP, aimbot, and radar from live Project Zomboid sessions.</p>
		</header>
		<div class="features-detail__gallery-grid">
			{
				featureGallery.map((image) => {
					const responsive = responsiveImage(image.src);
					return (
						<figure class="features-detail__gallery-item media-frame">
							<img
								src={responsive.src}
								srcset={responsive.srcset}
								sizes={featureGallerySizes}
								alt={image.alt}
								width="360"
								height="225"
								loading="lazy"
								decoding="async"
								draggable="false"
							/>
						</figure>
					);
				})
			}
		</div>
	</section>

	<div class="features-detail__cta">
		<RippleButton
			href={siteConfig.checkoutUrl}
			variant="buy"
			class="features-detail__pricing-link"
			rel="noopener noreferrer"
		>
			{ui.common.buyNow} — from ${productInfo.plans[0].price}/mo
		</RippleButton>
		<a href={siteConfig.checkoutUrl} class="features-detail__checkout-link" rel="noopener noreferrer">
			{ui.product.addToCart}
		</a>
	</div>
</div>

<style>
	.features-detail {
		display: grid;
		gap: clamp(1.35rem, 3vw, 2rem);
		width: 100%;
		margin: 0;
	}

	.features-detail__section {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1rem 1.35rem;
		align-items: start;
		padding: clamp(1rem, 2vw, 1.35rem);
		border-radius: var(--radius-card);
		border: 1px solid var(--color-border);
		background: rgba(17, 21, 20, 0.55);
	}

	@media (min-width: 768px) {
		.features-detail__section {
			grid-template-columns: 240px minmax(0, 1fr);
		}
	}

	.features-detail__figure {
		margin: 0;
		width: 100%;
		max-width: 240px;
		aspect-ratio: 16 / 10;
		border: 1px solid rgba(104, 112, 82, 0.16);
		border-radius: 0.75rem;
		overflow: hidden;
	}

	@media (min-width: 768px) {
		.features-detail__figure {
			position: sticky;
			top: 5.5rem;
		}
	}

	.features-detail__figure.media-frame img,
	.features-detail__gallery-item.media-frame img {
		transform: none;
	}

	.features-detail__figure img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
	}

	.features-detail__section-body {
		display: grid;
		gap: 1rem;
		min-width: 0;
	}

	.features-detail__section-head {
		display: grid;
		gap: 0.45rem;
		padding-bottom: 0.85rem;
		border-bottom: 1px solid rgba(104, 112, 82, 0.12);
	}

	.features-detail__section-head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.15rem, 2.2vw, 1.35rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--color-ink);
		line-height: 1.25;
	}

	.features-detail__section-head p {
		margin: 0;
		color: var(--color-muted);
		font-size: 0.9rem;
		line-height: 1.55;
	}

	.features-detail__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0;
	}

	.features-detail__item {
		display: grid;
		grid-template-columns: 0.85rem minmax(0, 1fr);
		column-gap: 0.55rem;
		row-gap: 0.2rem;
		padding: 0.75rem 0;
		border-bottom: 1px solid rgba(104, 112, 82, 0.1);
		align-items: start;
	}

	.features-detail__item::before {
		content: '›';
		grid-column: 1;
		grid-row: 1;
		color: var(--color-orchid);
		font-weight: 800;
		font-size: 0.95rem;
		line-height: 1.35;
	}

	.features-detail__item:last-child {
		border-bottom: 0;
		padding-bottom: 0;
	}

	.features-detail__item:first-child {
		padding-top: 0;
	}

	.features-detail__item h3 {
		grid-column: 2;
		margin: 0;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--color-ink);
		line-height: 1.35;
	}

	.features-detail__item p {
		grid-column: 2;
		margin: 0;
		padding-left: 0;
		color: var(--color-muted);
		font-size: 0.86rem;
		line-height: 1.5;
	}

	.features-detail__gallery {
		display: grid;
		gap: 1rem;
		padding: clamp(1rem, 2vw, 1.35rem);
		border-radius: var(--radius-card);
		border: 1px solid var(--color-border);
		background: rgba(17, 21, 20, 0.55);
	}

	.features-detail__gallery-head {
		display: grid;
		gap: 0.35rem;
		text-align: center;
	}

	.features-detail__gallery-head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.1rem, 2vw, 1.3rem);
		font-weight: 800;
		color: var(--color-ink);
	}

	.features-detail__gallery-head p {
		margin: 0 auto;
		max-width: 34rem;
		color: var(--color-muted);
		font-size: 0.88rem;
		line-height: 1.5;
	}

	.features-detail__gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
		gap: 0.65rem;
		width: 100%;
	}

	.features-detail__gallery-item {
		margin: 0;
		aspect-ratio: 16 / 10;
		border: 1px solid rgba(104, 112, 82, 0.12);
		border-radius: 0.6rem;
		overflow: hidden;
	}

	.features-detail__gallery-item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
	}

	.features-detail__cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: center;
		padding-top: 0.15rem;
	}

	.features-detail__pricing-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.95rem 1.35rem;
		border-radius: 0.75rem;
		font-weight: 700;
		text-decoration: none;
	}

	.features-detail__checkout-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.95rem 1.35rem;
		border-radius: 0.75rem;
		border: 1px solid var(--color-border);
		background: rgba(17, 21, 20, 0.9);
		color: var(--color-muted);
		font-weight: 650;
		text-decoration: none;
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	.features-detail__checkout-link:hover {
		color: var(--color-ink);
		border-color: rgba(104, 112, 82, 0.45);
	}

	@media (max-width: 767px) {
		.features-detail__figure {
			max-width: min(100%, 280px);
			margin-inline: auto;
		}
	}

	@media (max-width: 640px) {
		.features-detail__gallery-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.features-detail__cta {
			flex-direction: column;
		}

		.features-detail__pricing-link,
		.features-detail__checkout-link {
			width: 100%;
		}
	}
</style>
