---
import type { PageSection } from '../data/i18n/content.generated';

interface Props {
	sections: PageSection[];
	localizeParagraphHtml: (html: string) => string;
}

const { sections, localizeParagraphHtml } = Astro.props;
---

{
	sections.map((section) => (
		<section class="card-panel">
			<h2>{section.h2}</h2>
			{section.paragraphs.map((p) => (
				<p set:html={localizeParagraphHtml(p)} />
			))}
			{section.list && (
				<ul>
					{section.list.map((item) => (
						<li set:html={item} />
					))}
				</ul>
			)}
		</section>
	))
}
