---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import RippleButton from '../components/inspira/RippleButton.astro';
import { getUi } from '../data/i18n';
import { getBreadcrumbLabelForPage, getLocalizedPath } from '../data/i18n/routing';
import { zomboidImages } from '../data/zomboid';
import { heroPreloadSrc, heroSizes, heroSrcSet, heroIsExternal, contentSrc, contentSrcSet, galleryTileSizes, isExternalImage } from '../lib/responsive-images';
import { englishPaths, pageIds, type PageId } from '../data/i18n/routing';
import { defaultLocale } from '../data/i18n/locales';

type GalleryInput = string | { src: string; alt: string };

interface Props {
	title: string;
	description: string;
	canonicalPath?: string;
	heading: string;
	intro: string;
	eyebrow?: string;
	heroImage?: string;
	heroAlt?: string;
	gallery?: ReadonlyArray<GalleryInput>;
	galleryTitle?: string;
	ctaPrimary?: { href: string; label: string };
	ctaSecondary?: { href: string; label: string };
	showGallery?: boolean;
	hideBanner?: boolean;
	locale?: import('../data/i18n/locales').LocaleCode;
	pageId?: import('../data/i18n/content.generated').PageId;
	extraGraph?: Record<string, unknown>[];
	contentWidth?: 'narrow' | 'full';
}

const {
	title,
	description,
	canonicalPath = '/',
	heading,
	intro,
	eyebrow,
	heroImage = zomboidImages.hero,
	heroAlt = 'Project Zomboid cheats product preview',
	gallery = zomboidImages.product.slice(0, 3),
	galleryTitle = 'Project Zomboid cheats UI reference',
	ctaPrimary,
	ctaSecondary,
	showGallery = true,
	hideBanner = false,
	locale = defaultLocale,
	pageId: pageIdProp,
	extraGraph = [],
	contentWidth = 'narrow',
} = Astro.props;

function resolvePageId(path: string): PageId | undefined {
	for (const id of pageIds) {
		if (englishPaths[id] === path) return id;
	}
	return undefined;
}

const pageId = pageIdProp ?? resolvePageId(canonicalPath);

const ui = getUi(locale);
const homeHref = getLocalizedPath('home', locale);
const isHomeLcp = pageId === 'home';

const normalizedGallery = gallery
	.map((item) => {
		if (typeof item !== 'string') {
			return {
				src: contentSrc(item.src),
				srcset: contentSrcSet(item.src),
				alt: item.alt,
			};
		}

		const file = item.split('/').pop()?.replace(/\.webp$/i, '') ?? 'project-zomboid-cheats';
		const keywordAlt = file
			.split('-')
			.map((part) => part.charAt(0).toUpperCase() + part.slice(1))
			.join(' ');

		return {
			src: contentSrc(item),
			srcset: contentSrcSet(item),
			alt: heroAlt || `${keywordAlt} - ${ui.product.title}`,
		};
	})
	.filter((item) => Boolean(item.src));

const breadcrumbLabel = getBreadcrumbLabelForPage(pageId, ui.nav, heading);

const breadcrumbs = [
	{ label: ui.nav.home, href: homeHref },
	{ label: breadcrumbLabel },
];

const isHeroLcp = isHomeLcp && heroImage === zomboidImages.hero;
const bannerIsExternal = isExternalImage(heroImage);
const lcpImage = isHeroLcp ? heroPreloadSrc : undefined;
const lcpImageSrcSet = isHeroLcp ? heroSrcSet : undefined;
const lcpImageSizes = isHeroLcp ? heroSizes : undefined;
---

<Layout
	title={title}
	description={description}
	canonicalPath={canonicalPath}
	ogImage={heroImage}
	ogImageAlt={heroAlt}
	breadcrumbs={breadcrumbs}
	locale={locale}
	pageId={pageId}
	extraGraph={extraGraph}
	lcpImage={lcpImage}
	lcpImageSrcSet={lcpImageSrcSet}
	lcpImageSizes={lcpImageSizes}
>
	<Navbar locale={locale} pageId={pageId} />
	<main class:list={['page', hideBanner && 'page--compact']}>
		{
			!hideBanner && (
		<section class="banner">
			<div class="banner__media">
				{
					isHeroLcp ? (
						heroIsExternal ? (
							<img
								src={heroPreloadSrc}
								alt={heroAlt}
								width="1600"
								height="900"
								class="banner__img"
								fetchpriority="high"
								decoding="sync"
							/>
						) : (
						<picture>
							<source media="(max-width: 760px)" srcset={heroPreloadSrc} type="image/webp" />
							<source
								media="(min-width: 761px)"
								srcset={heroSrcSet}
								sizes={heroSizes}
								type="image/webp"
							/>
							<img
								src={heroPreloadSrc}
								alt={heroAlt}
								width="1600"
								height="900"
								class="banner__img"
								fetchpriority="high"
								decoding="sync"
							/>
						</picture>
						)
					) : bannerIsExternal ? (
						<img
							src={heroImage}
							alt={heroAlt}
							width="1600"
							height="900"
							class="banner__img"
							loading="lazy"
							decoding="async"
						/>
					) : (
						<picture>
							<source
								media="(max-width: 760px)"
								srcset={contentSrc(heroImage)}
								type="image/webp"
							/>
							<source
								media="(min-width: 761px)"
								srcset={contentSrcSet(heroImage) ?? contentSrc(heroImage)}
								sizes="100vw"
								type="image/webp"
							/>
							<img
								src={contentSrc(heroImage)}
								srcset={contentSrcSet(heroImage)}
								sizes="100vw"
								alt={heroAlt}
								width="1600"
								height="900"
								class="banner__img"
								loading="eager"
								decoding="async"
								fetchpriority="low"
							/>
						</picture>
					)
				}
				<div class="banner__scrim" aria-hidden="true"></div>
			</div>
			<div class="shell banner__content">
				<nav class="banner__crumbs" aria-label="Breadcrumb">
					<a href={homeHref}>{ui.nav.home}</a>
					<span aria-hidden="true">/</span>
					<span aria-current="page">{breadcrumbLabel}</span>
				</nav>
				<h1 class="banner__title">{heading}</h1>
				<p class="banner__intro">{intro}</p>
				{
					(ctaPrimary || ctaSecondary) && (
						<div class="banner__actions">
							{ctaPrimary && (
								<RippleButton
									href={ctaPrimary.href}
									variant={ctaPrimary.label === 'Buy Now' ? 'buy' : 'primary'}
									rel={ctaPrimary.href.startsWith('http') ? 'noopener noreferrer' : undefined}
								>
									{ctaPrimary.label}
								</RippleButton>
							)}
							{ctaSecondary && (
								<RippleButton
									href={ctaSecondary.href}
									variant={ctaSecondary.label === 'Buy Now' ? 'buy' : 'ghost'}
									rel={ctaSecondary.href.startsWith('http') ? 'noopener noreferrer' : undefined}
								>
									{ctaSecondary.label}
								</RippleButton>
							)}
						</div>
					)
				}
			</div>
		</section>
			)
		}

		<div class="shell page__wrap">
			<article class:list={['article', contentWidth === 'full' && 'article--full']}>
				<slot />
			</article>

			{
				showGallery && normalizedGallery.length > 0 && (
					<section class="gallery-block" aria-labelledby="page-gallery-title">
						<div class="gallery-block__head">
							<h2 id="page-gallery-title" class="gallery-block__title">{galleryTitle}</h2>
						</div>
						<div class="gallery-block__grid">
							{normalizedGallery.map((image) => (
								<figure class="gallery-block__item">
									<img
										src={image.src}
										srcset={image.srcset}
										sizes={galleryTileSizes}
										alt={image.alt}
										width="800"
										height="500"
										loading="lazy"
										decoding="async"
									/>
									<figcaption>{image.alt}</figcaption>
								</figure>
							))}
						</div>
					</section>
				)
			}
		</div>
	</main>
	<SiteFooter locale={locale} />
</Layout>

<style>
	.page {
		overflow-x: clip;
		padding-bottom: calc(3.25rem + env(safe-area-inset-bottom, 0px));
	}

	.page--compact .page__wrap {
		padding-top: clamp(1.5rem, 3vw, 2rem);
	}

	.page--compact .article--full {
		gap: clamp(1.5rem, 3vw, 2.25rem);
	}

	.banner {
		position: relative;
		isolation: isolate;
		min-height: clamp(132px, 22vh, 200px);
		overflow: hidden;
		border-bottom: 1px solid rgba(104, 112, 82, 0.12);
		margin-bottom: 1.35rem;
	}

	.banner__media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.banner__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 30%;
	}

	.banner__scrim {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(9, 11, 11, 0.72) 0%, rgba(9, 11, 11, 0.88) 100%),
			linear-gradient(90deg, rgba(9, 11, 11, 0.55), rgba(9, 11, 11, 0.35) 50%, rgba(9, 11, 11, 0.55));
	}

	.banner__content {
		position: relative;
		z-index: 1;
		max-width: 640px;
		margin-inline: auto;
		padding: 1.35rem 0 1.2rem;
		text-align: center;
	}

	.banner__crumbs {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-bottom: 0.55rem;
		font-size: 0.68rem;
		color: var(--color-faint);
	}

	.banner__crumbs a {
		color: var(--color-muted);
		font-weight: 600;
	}

	.banner__crumbs a:hover {
		color: var(--color-orchid);
	}

	.banner__eyebrow {
		margin: 0 0 0.35rem;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-orchid);
	}

	.banner__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.15rem, 2.8vw, 1.55rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.18;
		color: #ffffff;
	}

	.banner__intro {
		margin: 0.55rem auto 0;
		max-width: 34rem;
		color: rgba(255, 255, 255, 0.88);
		font-size: 0.82rem;
		line-height: 1.55;
	}

	.banner__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.45rem;
		margin-top: 0.75rem;
	}

	.banner__actions :global(.inspira-ripple-btn),
	.banner__actions :global(.btn-buy),
	.banner__actions :global(.btn) {
		min-height: 2.15rem;
		padding: 0.45rem 0.85rem;
		font-size: 0.78rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.7rem;
		padding: 0.7rem 1.15rem;
		border-radius: 0.75rem;
		font-size: 0.92rem;
		font-weight: 700;
		transition:
			transform 0.2s ease,
			filter 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease;
	}

	.btn--primary {
		background: var(--gradient-brand);
		color: white;
		box-shadow: 0 8px 18px rgba(0, 0, 0, 0.28);
	}

	.btn--primary:hover {
		transform: translateY(-1px);
		filter: brightness(1.05);
		color: white;
	}

	.btn--ghost {
		border: 1px solid rgba(104, 112, 82, 0.28);
		background: rgba(17, 21, 20, 0.55);
		color: var(--color-ink);
	}

	.btn--ghost:hover {
		border-color: rgba(104, 112, 82, 0.5);
		color: var(--color-ink);
	}

	.page__wrap {
		display: grid;
		gap: 2.5rem;
		padding-top: 0.25rem;
	}

	.article {
		width: 100%;
		max-width: 760px;
		margin-inline: auto;
		display: grid;
		gap: 1.35rem;
		text-align: left;
		color: #ffffff;
		line-height: 1.72;
	}

	.article--full {
		max-width: var(--page-max);
	}

	.article :global(.card-panel) {
		padding: clamp(1.25rem, 2.5vw, 1.55rem) clamp(1.3rem, 2.5vw, 1.6rem);
		border-radius: 1rem;
		border: 1px solid rgba(104, 112, 82, 0.16);
		background: linear-gradient(145deg, rgba(23, 27, 26, 0.94) 0%, rgba(17, 21, 20, 0.9) 100%);
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.16);
		display: grid;
		gap: 0.95rem;
		transition:
			border-color 0.22s ease,
			transform 0.22s ease,
			box-shadow 0.22s ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.article :global(.card-panel:hover) {
			border-color: rgba(210, 174, 118, 0.28);
			transform: translateY(-1px);
			box-shadow: 0 14px 32px rgba(0, 0, 0, 0.22);
		}
	}

	.article :global(h2) {
		position: relative;
		margin: 0;
		padding-left: 0.85rem;
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 2.5vw, 1.45rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.3;
		color: var(--color-ink);
	}

	.article :global(h2)::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.12em;
		bottom: 0.12em;
		width: 3px;
		border-radius: 999px;
		background: linear-gradient(180deg, #d2ae76 0%, #687052 100%);
	}

	.article :global(h3) {
		margin: 0.15rem 0 0;
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--color-orchid);
	}

	.article :global(p) {
		margin: 0;
		color: rgba(255, 255, 255, 0.84);
		font-size: 0.98rem;
	}

	.article :global(.card-panel p + p) {
		margin-top: 0.85rem;
	}

	.article :global(.card-panel > p:first-of-type) {
		font-size: 1.02rem;
		line-height: 1.68;
		color: rgba(255, 255, 255, 0.9);
	}

	.article :global(.card-panel ul) {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.5rem;
	}

	.article :global(.card-panel li) {
		position: relative;
		padding: 0.65rem 0.85rem 0.65rem 2rem;
		border-radius: 0.7rem;
		background: rgba(9, 11, 11, 0.45);
		border: 1px solid rgba(104, 112, 82, 0.12);
		color: rgba(255, 255, 255, 0.8);
		font-size: 0.96rem;
		line-height: 1.55;
	}

	.article :global(.card-panel li::before) {
		content: '';
		position: absolute;
		left: 0.8rem;
		top: 50%;
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 999px;
		background: var(--color-orchid);
		transform: translateY(-50%);
	}

	.article :global(a:not(.btn-buy):not(.btn):not(.pricing-showcase__cart):not(.features-detail__pricing-link):not(.features-detail__checkout-link)) {
		color: var(--color-orchid);
		font-weight: 600;
	}

	.article :global(a:not(.btn-buy):not(.btn):not(.pricing-showcase__cart):not(.features-detail__pricing-link):not(.features-detail__checkout-link):hover) {
		color: #D2AE76;
	}

	.article :global(.btn-buy),
	.article :global(.btn-buy:hover),
	.article :global(.btn-buy:visited),
	.article :global(.btn-buy:focus-visible) {
		color: #ffffff;
		text-shadow: 0 1px 3px rgba(9, 11, 11, 0.55);
	}

	.article :global(.price-grid) {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.article :global(.price-card) {
		display: grid;
		gap: 0.3rem;
		justify-items: center;
		padding: 1.2rem 0.9rem;
		border-radius: 0.85rem;
		border: 1px solid rgba(104, 112, 82, 0.18);
		background: rgba(9, 11, 11, 0.45);
		text-align: center;
		text-decoration: none;
		color: inherit;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	.article :global(.price-card:hover) {
		border-color: rgba(104, 112, 82, 0.4);
		transform: translateY(-1px);
	}

	.article :global(.price-card.is-featured) {
		background: linear-gradient(160deg, #687052, #D2AE76 55%, #D2AE76);
		border-color: transparent;
		color: white;
	}

	.article :global(.price-card.is-featured .price-card__meta) {
		color: rgba(255, 255, 255, 0.88);
	}

	.article :global(.price-card__label) {
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.article :global(.price-card__price) {
		font-family: var(--font-display);
		font-size: 1.9rem;
		font-weight: 800;
		color: var(--color-ink);
	}

	.article :global(.price-card.is-featured .price-card__price) {
		color: white;
	}

	.article :global(.price-card__meta) {
		font-size: 0.78rem;
		color: var(--color-muted);
	}

	.article :global(.cta-row) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 0.25rem;
	}

	.article :global(.cta-btn) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.55rem;
		padding: 0.65rem 1.05rem;
		border-radius: 0.7rem;
		font-size: 0.9rem;
		font-weight: 700;
		transition:
			transform 0.2s ease,
			filter 0.2s ease,
			border-color 0.2s ease;
	}

	.article :global(.cta-btn--primary) {
		background: var(--gradient-brand);
		color: white;
		box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
	}

	.article :global(.cta-btn--primary:hover) {
		transform: translateY(-1px);
		filter: brightness(1.05);
		color: white;
	}

	.article :global(.cta-btn--ghost) {
		border: 1px solid rgba(104, 112, 82, 0.28);
		background: transparent;
		color: var(--color-ink);
	}

	.article :global(.cta-btn--ghost:hover) {
		border-color: rgba(104, 112, 82, 0.5);
		color: var(--color-ink);
	}

	.gallery-block {
		width: 100%;
		max-width: var(--page-max);
		margin-inline: auto;
		display: grid;
		gap: 1rem;
		padding-top: 0.5rem;
		border-top: 1px solid rgba(104, 112, 82, 0.12);
	}

	.gallery-block__head {
		text-align: center;
	}

	.gallery-block__eyebrow {
		margin: 0 0 0.35rem;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-orchid);
	}

	.gallery-block__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 800;
	}

	.gallery-block__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.gallery-block__item {
		position: relative;
		margin: 0;
		overflow: hidden;
		border-radius: 0.85rem;
		border: 1px solid rgba(104, 112, 82, 0.14);
		background: #111514;
		aspect-ratio: 16 / 10;
	}

	.gallery-block__item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1);
		transition: transform 0.35s ease;
	}

	.gallery-block__item:hover img {
		transform: scale(1.05);
	}

	@media (hover: none), (pointer: coarse) {
		.gallery-block__item:hover img {
			transform: none;
		}

		.gallery-block__item figcaption {
			opacity: 1;
		}
	}

	.gallery-block__item figcaption {
		position: absolute;
		inset: auto 0 0;
		padding: 1.4rem 0.75rem 0.65rem;
		background: linear-gradient(transparent, rgba(9, 11, 11, 0.92));
		color: var(--color-muted);
		font-size: 0.72rem;
		font-weight: 600;
	}

	@media (max-width: 800px) {
		.article :global(.price-grid) {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.page {
			padding-bottom: calc(2rem + env(safe-area-inset-bottom, 0px));
		}

		.banner {
			margin-bottom: 1rem;
			min-height: auto;
		}

		.banner__content {
			padding: 1.1rem 0 1rem;
			max-width: none;
		}

		.banner__crumbs {
			font-size: 0.64rem;
			margin-bottom: 0.45rem;
		}

		.banner__title {
			font-size: clamp(1.05rem, 4.8vw, 1.35rem);
			line-height: 1.2;
			overflow-wrap: anywhere;
		}

		.banner__intro {
			font-size: 0.78rem;
			line-height: 1.5;
			max-width: none;
		}

		.banner__actions {
			flex-direction: row;
			flex-wrap: wrap;
			align-items: center;
			justify-content: center;
			width: auto;
		}

		.banner__actions .inspira-ripple-btn,
		.banner__actions .btn-buy,
		.banner__actions .btn {
			width: auto;
			min-height: 2.1rem;
		}

		.page__wrap {
			gap: 1.35rem;
		}

		.article {
			width: 100%;
		}

		.article :global(.card-panel) {
